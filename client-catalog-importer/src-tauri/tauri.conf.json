{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nightingale Catalog Importer",
  "version": "0.1.0",
  "identifier": "com.rzru.catalog-importer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nightingale Catalog Importer",
        "width": 520,
        "height": 360,
        "minWidth": 420,
        "minHeight": 300,
        "resizable": true,
        "decorations": true,
        "visible": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "shortDescription": "Imports catalog songs into Nightingale 1.0.0+ library databases.",
    "category": "Music",
    "copyright": "Copyright © 2026 rzru",
    "publisher": "rzru",
    "license": "GPL-3.0",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nightingale-import"]
      }
    }
  }
}
