---
const groups = [
  {
    tab: "Library",
    heading: "Your music library",
    items: [
      {
        title: "Your music sources",
        description:
          "Scan audio, video, and UltraStar files in a folder, or connect Plex, Jellyfin, or Navidrome.",
      },
      {
        title: "Find and sort songs",
        description:
          "Browse in table or grid view, sort by multiple columns, and run bulk actions on filtered songs.",
      },
      {
        title: "Keep the set moving",
        description:
          "Queue requests, see what's next, and manage songs while playback continues in Session mode.",
      },
      {
        title: "Self-hosted web",
        description:
          "Run Nightingale on a Linux computer at home and open it from another device's browser.",
      },
    ],
  },
  {
    tab: "Lyrics",
    heading: "Lyrics and audio",
    items: [
      {
        title: "Instrumental or original mix",
        description:
          "Separate vocals with UVR or Demucs and adjust the guide vocal. With your own lyrics, you can sing over the original mix instead.",
      },
      {
        title: "Bring your own lyrics",
        description:
          "Use a local LRC, paste timed or plain lyrics, browse LRCLIB matches, or edit lyrics in the app.",
      },
      {
        title: "Automatic lyrics",
        description:
          "Transcribe and align lyrics word by word with Whisper or experimental Parakeet.",
      },
      {
        title: "CJK lyrics",
        description:
          "Japanese, Chinese, Cantonese, and Korean lyrics can show romanized readings above each token.",
      },
      {
        title: "UltraStar songs",
        description:
          "Import USDX folders with built-in pitch and lyrics, without analyzing the song first. Experimental.",
      },
    ],
  },
  {
    tab: "Playback",
    heading: "On stage",
    items: [
      {
        title: "Pitch scoring",
        description:
          "Sing into your mic for real-time scores, star ratings, and per-song scoreboards.",
      },
      {
        title: "Make it yours",
        description:
          "Adjust key and tempo, position lyrics on screen, and scale lyrics and the pitch graph independently.",
      },
      {
        title: "Backgrounds and video",
        description:
          "Choose audio-reactive visuals or video backgrounds. Video files can play their own footage behind the lyrics.",
      },
      {
        title: "Mic setup",
        description:
          "Monitor your voice, adjust gain, and run a latency test for tighter scoring.",
      },
    ],
  },
  {
    tab: "Everyday",
    heading: "Made for sharing",
    items: [
      {
        title: "Player profiles",
        description:
          "Switch singers without losing individual scores and song histories.",
      },
      {
        title: "Gamepad and touch",
        description:
          "Navigate with a controller or use on-screen playback controls on touch devices.",
      },
      {
        title: "Desktop setup and storage",
        description:
          "Required tools are prepared on first launch. Keep cache, models, and videos in separate folders if you like.",
      },
      {
        title: "Updates",
        description:
          "Install signed updates in the app on macOS and Windows, or download new Linux releases from GitHub.",
      },
    ],
  },
];
---

<section class="features" id="features" aria-labelledby="features-title">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title" id="features-title">Features</h2>
      <a href="/docs/" class="docs-link">Explore docs <span aria-hidden="true">↗</span></a>
    </div>

    <nav class="feature-nav" aria-label="Feature categories">
      {groups.map((group, index) => (
        <a class="feature-tab" href={`#feature-${index + 1}`} aria-current={index === 0 ? "true" : undefined}>
          {group.tab}
        </a>
      ))}
    </nav>

    <div class="feature-track" role="region" aria-label="Feature categories" tabindex="0">
      {groups.map((group, index) => (
        <div
          class="feature-slide"
          id={`feature-${index + 1}`}
          role="group"
          aria-roledescription="slide"
          aria-label={`${index + 1} of ${groups.length}: ${group.heading}`}
        >
          <h3>{group.heading}</h3>
          <div class="feature-list">
            {group.items.map((feature) => (
              <details class="feature-item" name="nightingale-feature">
                <summary><span>{feature.title}</span><span class="feature-plus" aria-hidden="true">+</span></summary>
                <p>{feature.description}</p>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="feature-controls" hidden>
      <span class="feature-position" aria-live="polite">1 / {groups.length}</span>
      <div>
        <button class="feature-prev" type="button" aria-label="Previous feature category" disabled>←</button>
        <button class="feature-next" type="button" aria-label="Next feature category">→</button>
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>(".feature-track");
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>(".feature-tab")];
  const controls = document.querySelector<HTMLElement>(".feature-controls");
  const previous = controls?.querySelector<HTMLButtonElement>(".feature-prev");
  const next = controls?.querySelector<HTMLButtonElement>(".feature-next");
  const position = controls?.querySelector<HTMLElement>(".feature-position");

  if (track && controls && previous && next && position) {
    let activeIndex = 0;
    controls.hidden = false;

    const update = () => {
      activeIndex = Math.min(tabs.length - 1, Math.max(0, Math.round(track.scrollLeft / track.clientWidth)));
      tabs.forEach((tab, index) => {
        if (index === activeIndex) tab.setAttribute("aria-current", "true");
        else tab.removeAttribute("aria-current");
      });
      previous.disabled = activeIndex === 0;
      next.disabled = activeIndex === tabs.length - 1;
      position.textContent = `${activeIndex + 1} / ${tabs.length}`;
    };

    const show = (index: number) => {
      track.scrollTo({
        left: index * track.clientWidth,
        behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", (event) => {
        event.preventDefault();
        show(index);
      });
    });
    previous.addEventListener("click", () => show(activeIndex - 1));
    next.addEventListener("click", () => show(activeIndex + 1));
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", () => {
      track.scrollLeft = activeIndex * track.clientWidth;
      update();
    });
    update();
  }
</script>

<style>
  .features {
    border-top: 1px solid var(--border);
    background: var(--bg-2);
  }

  .section-head {
    margin-block-end: 36px;
  }

  .feature-nav {
    display: flex;
    gap: clamp(20px, 4vw, 56px);
    overflow-x: auto;
    border-bottom: 1px solid var(--border);
    scrollbar-width: none;
  }

  .feature-nav::-webkit-scrollbar,
  .feature-track::-webkit-scrollbar {
    display: none;
  }

  .feature-tab {
    flex: none;
    padding-block: 12px 18px;
    border-bottom: 2px solid transparent;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .feature-tab:hover,
  .feature-tab[aria-current="true"] {
    color: var(--text-primary);
  }

  .feature-tab[aria-current="true"] {
    border-color: var(--cyan);
  }

  .feature-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
  }

  .feature-slide {
    flex: 0 0 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: start;
    gap: clamp(40px, 8vw, 120px);
    padding-block: clamp(40px, 6vw, 80px);
    scroll-snap-align: start;
  }

  .feature-slide h3 {
    max-width: 12ch;
    font-size: clamp(2.2rem, 4vw, 4rem);
  }

  .feature-item {
    border-top: 1px solid var(--border);
    interpolate-size: allow-keywords;
  }

  .feature-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .feature-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 64px;
    padding-block: 12px;
    list-style: none;
    font-size: clamp(1rem, 1.45vw, 1.18rem);
    font-weight: 600;
    cursor: pointer;
  }

  .feature-item summary::-webkit-details-marker {
    display: none;
  }

  .feature-item summary:hover,
  .feature-item[open] summary {
    color: var(--cyan);
  }

  .feature-plus {
    flex: none;
    color: var(--cyan);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1;
    transition: transform 0.25s ease;
  }

  .feature-item[open] .feature-plus {
    transform: rotate(45deg);
  }

  .feature-item::details-content {
    block-size: 0;
    opacity: 0;
    overflow: hidden;
    transition: block-size 0.3s ease, opacity 0.25s ease, content-visibility 0.3s allow-discrete;
  }

  .feature-item[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  .feature-item p {
    max-width: 63ch;
    padding-block: 0 24px;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .feature-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--border);
    padding-block-start: 20px;
  }

  .feature-controls[hidden] {
    display: none;
  }

  .feature-position {
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
  }

  .feature-controls > div {
    display: flex;
    gap: 8px;
  }

  .feature-controls button {
    width: 48px;
    height: 48px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-primary);
    font-size: 1.2rem;
  }

  .feature-controls button:hover:not(:disabled) {
    border-color: var(--cyan);
    color: var(--cyan);
  }

  .feature-controls button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  @media (max-width: 760px) {
    .feature-slide {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-plus,
    .feature-item::details-content {
      transition: none;
    }
  }
</style>
