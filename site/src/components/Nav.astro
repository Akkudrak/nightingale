---
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="Nightingale home">
      <img src="/logo_square.png" alt="" width="38" height="38" />
      <span>Nightingale</span>
    </a>
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
      <span></span><span></span>
    </button>
    <div class="nav-links" id="nav-links">
      <a href="#how-it-works">How it works</a>
      <a href="#features">Features</a>
      <a href="/docs/">Docs</a>
      <a href="#donate">Support</a>
      <a href="https://discord.gg/68Vgng9vYp" target="_blank" rel="noopener noreferrer">Discord</a>
      <a href="https://github.com/rzru/nightingale" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="#download" class="nav-cta">Download <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const links = document.querySelector<HTMLElement>(".nav-links");

  toggle?.addEventListener("click", () => {
    const open = links?.classList.toggle("is-open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });

  links?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      links.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", "Open menu");
    });
  });
</script>

<style>
  .site-nav {
    position: sticky;
    z-index: 30;
    top: 0;
    border-bottom: 1px solid var(--border);
    background: #0a0a12c9;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .nav-inner,
  .brand,
  .nav-links {
    display: flex;
    align-items: center;
  }

  .nav-inner {
    justify-content: space-between;
    min-height: 72px;
    gap: 24px;
  }

  .brand {
    flex: none;
    gap: 10px;
    font-size: 1.08rem;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .brand:hover {
    color: var(--text-primary);
  }

  .nav-links {
    gap: clamp(12px, 1.8vw, 28px);
    color: var(--text-secondary);
    font-size: 0.84rem;
    font-weight: 550;
  }

  .nav-links a {
    white-space: nowrap;
  }

  .nav-cta {
    padding: 10px 16px;
    background: var(--accent);
    color: white;
  }

  .nav-cta:hover {
    background: var(--accent-hover);
    color: #080b1b;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-primary);
  }

  .menu-toggle span {
    width: 18px;
    height: 1px;
    background: currentColor;
  }

  @media (max-width: 920px) {
    .menu-toggle {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      inset: 72px 0 auto;
      padding: 16px 24px 24px;
      background: var(--bg-2);
      border-bottom: 1px solid var(--border);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav-links.is-open {
      display: flex;
    }

    .nav-links a {
      padding: 11px 0;
    }

    .nav-links .nav-cta {
      margin-top: 12px;
      padding: 12px 16px;
    }
  }
</style>
