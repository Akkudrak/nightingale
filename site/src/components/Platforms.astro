---
const platforms = [
  { name: "Linux", targets: ["x86_64", "aarch64"] },
  { name: "macOS", targets: ["ARM", "Intel"] },
  { name: "Windows", targets: ["x86_64"] },
];
---

<section id="platforms">
  <div class="container platforms-layout">
    <div>
      <h2 class="section-title">Built for Linux, macOS &amp; Windows.</h2>
      <p class="section-sub">
        Native builds for Linux, macOS, and Windows. GPU acceleration via CUDA or
        Metal when available, with a CPU fallback everywhere else.
      </p>
    </div>
    <div class="platform-list">
      {platforms.map((platform) => (
        <div class="platform">
          <strong>{platform.name}</strong>
          <span>{platform.targets.join(" · ")}</span>
        </div>
      ))}
      <a href="#download" class="platform-download">Choose your download <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  #platforms {
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  .platforms-layout {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: clamp(40px, 8vw, 120px);
  }

  .platform {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-block: 22px;
    border-top: 1px solid var(--border);
  }

  .platform strong {
    font-size: 1.18rem;
  }

  .platform span {
    color: var(--text-secondary);
    font-size: 0.88rem;
  }

  .platform-download {
    display: flex;
    justify-content: space-between;
    margin-block-start: 12px;
    padding: 16px;
    background: var(--accent);
    color: white;
    font-weight: 650;
  }

  .platform-download:hover {
    background: var(--accent-hover);
    color: #080b1b;
  }

  @media (max-width: 780px) {
    .platforms-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
