---
const cards = [
  {
    title: "Patreon",
    subtitle: "Recurring monthly support",
    desc: "Back the project every month. Helps cover hosting, hardware for testing, and ongoing development.",
    href: "https://www.patreon.com/cw/nightingalekaraoke",
    cta: "Support on Patreon",
  },
  {
    title: "Ko-fi",
    subtitle: "One-off tip",
    desc: "Drop a one-time tip the size of a coffee. No account required.",
    href: "https://ko-fi.com/nightingalekaraoke",
    cta: "Buy a coffee",
  },
];
---

<section id="donate">
  <div class="container donate-layout">
    <div>
      <h2 class="section-title">Support Nightingale.</h2>
      <p class="section-sub">
        Nightingale is open-source, free, and built by one person in their spare time.
        If it brings you joy, consider chipping in — recurring on Patreon or one-off on Ko-fi.
      </p>
    </div>
    <div class="donate-links">
      {cards.map((card) => (
        <a href={card.href} target="_blank" rel="noopener noreferrer">
          <span class="donate-title">{card.title} <span aria-hidden="true">↗</span></span>
          <span class="donate-subtitle">{card.subtitle}</span>
          <span class="donate-desc">{card.desc}</span>
          <span class="donate-cta">{card.cta}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  #donate {
    border-top: 1px solid var(--border);
    background: var(--bg-2);
  }

  .donate-layout {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: clamp(40px, 8vw, 120px);
  }

  .donate-links a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: 26px;
    border-top: 1px solid var(--border);
  }

  .donate-links a:last-child {
    border-bottom: 1px solid var(--border);
  }

  .donate-links a:hover .donate-title {
    color: var(--cyan);
  }

  .donate-title {
    display: flex;
    justify-content: space-between;
    font-size: 1.35rem;
    font-weight: 700;
  }

  .donate-subtitle,
  .donate-desc {
    color: var(--text-secondary);
    font-size: 0.93rem;
  }

  .donate-cta {
    margin-block-start: 8px;
    color: var(--cyan);
    font-size: 0.9rem;
    font-weight: 600;
  }

  @media (max-width: 780px) {
    .donate-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
