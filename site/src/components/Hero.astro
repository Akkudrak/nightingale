---
import Video from "./Video.astro";
import pkg from "../../package.json";

const version = pkg.version;
const base = "https://github.com/rzru/nightingale/releases/latest/download";
---

<section class="hero" id="download">
  <div class="container">
    <h1>
      <span class="hero-lyric hero-lyric-first" data-text="Your music library,">Your music library,</span><br />
      <span class="hero-lyric hero-lyric-second" data-text="turned into karaoke.">turned into karaoke.</span>
    </h1>
    <div class="hero-stage">
      <div class="hero-demo">
        <Video src="https://github.com/rzru/nightingale/releases/download/v0.3.1/demo.mp4" />
      </div>
      <div class="hero-copy">
        <p>
          Pick a song you love. Nightingale finds or transcribes synced lyrics,
          makes an instrumental when you need one, and lets you set key and tempo
          to suit your voice. Sing with optional pitch scoring and visuals that
          react to your voice.
        </p>
        <div class="download-options">
          <details class="download-option" id="download-linux" data-platform="linux">
            <summary>Download for Linux <span aria-hidden="true">↗</span></summary>
            <div class="package-links">
              <a href={`${base}/Nightingale_${version}_amd64.deb`} target="_blank" rel="noopener noreferrer">.deb · x86_64</a>
              <a href={`${base}/Nightingale_${version}_arm64.deb`} target="_blank" rel="noopener noreferrer">.deb · ARM</a>
              <a href={`${base}/Nightingale-${version}-1.x86_64.rpm`} target="_blank" rel="noopener noreferrer">.rpm · x86_64</a>
              <a href={`${base}/Nightingale-${version}-1.aarch64.rpm`} target="_blank" rel="noopener noreferrer">.rpm · ARM</a>
            </div>
          </details>
          <details class="download-option" id="download-windows" data-platform="windows">
            <summary>Download for Windows <span aria-hidden="true">↗</span></summary>
            <div class="package-links">
              <a href={`${base}/Nightingale_${version}_x64-setup.exe`} target="_blank" rel="noopener noreferrer">Installer (.exe)</a>
              <a href={`${base}/Nightingale_${version}_x64_en-US.msi`} target="_blank" rel="noopener noreferrer">MSI Installer</a>
            </div>
          </details>
          <a class="download-option" id="download-macos" data-platform="macos" href="/docs/getting-started.html">macOS <span aria-hidden="true">↗</span></a>
          <a href="/docs/self-hosted.html">Self-hosted web <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-meta">
          <a href={`https://github.com/rzru/nightingale/releases/tag/v${version}`} target="_blank" rel="noopener noreferrer">v{version} · free &amp; open source</a>
          <a href="/docs/">Read the docs <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const userAgent = navigator.userAgent;
  const platform = /android|iphone|ipad|ipod|mobile/i.test(userAgent)
    ? null
    : /windows/i.test(userAgent)
      ? "windows"
      : /macintosh|mac os x/i.test(userAgent)
        ? "macos"
        : /linux/i.test(userAgent)
          ? "linux"
          : null;

  const downloads = document.querySelector<HTMLElement>(".download-options");
  const detected = [...(downloads?.children ?? [])].find(
    (option) => option instanceof HTMLElement && option.dataset.platform === platform,
  );

  if (downloads && detected instanceof HTMLElement) {
    downloads.prepend(detected);
    detected.classList.add("is-detected");
    document.querySelector<HTMLAnchorElement>(".nav-cta")?.setAttribute("href", `#${detected.id}`);
  }
</script>

<style>
  .hero {
    position: relative;
    padding-block: clamp(70px, 8vw, 130px) clamp(90px, 10vw, 156px);
    background: var(--bg);
  }

  h1 {
    max-width: 1150px;
    margin-block-end: clamp(52px, 7vw, 100px);
    font-size: clamp(3.8rem, 8vw, 6rem);
    font-weight: 750;
    line-height: 1.03;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .hero-lyric {
    position: relative;
    display: inline-block;
    color: rgb(from var(--text-primary) r g b / 50%);
  }

  .hero-lyric::after {
    position: absolute;
    inset: 0;
    color: var(--text-primary);
    content: attr(data-text);
    clip-path: inset(-0.15em 100% -0.15em -0.05em);
    animation: 12s linear infinite;
  }

  .hero-lyric-first::after {
    animation-name: sing-first-line;
  }

  .hero-lyric-second::after {
    animation-name: sing-second-line;
  }

  @keyframes sing-first-line {
    0%, 8% {
      opacity: 1;
      clip-path: inset(-0.15em 100% -0.15em -0.05em);
    }

    36%, 78% {
      opacity: 1;
      clip-path: inset(-0.15em -0.05em);
    }

    100% {
      opacity: 0;
      clip-path: inset(-0.15em -0.05em);
    }
  }

  @keyframes sing-second-line {
    0%, 40% {
      opacity: 1;
      clip-path: inset(-0.15em 100% -0.15em -0.05em);
    }

    70%, 78% {
      opacity: 1;
      clip-path: inset(-0.15em -0.05em);
    }

    100% {
      opacity: 0;
      clip-path: inset(-0.15em -0.05em);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-lyric {
      color: var(--text-primary);
    }

    .hero-lyric::after {
      content: none;
    }
  }

  .hero-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(320px, 0.85fr);
    align-items: start;
    gap: clamp(32px, 5vw, 78px);
    border-top: 1px solid var(--border);
    padding-block-start: clamp(30px, 4vw, 54px);
  }

  .hero-demo {
    border: 1px solid #444a68;
    box-shadow: 0 28px 60px -28px #000c;
  }

  .hero-copy p {
    max-width: 44ch;
    color: var(--text-primary);
    font-size: clamp(1.05rem, 1.5vw, 1.26rem);
    line-height: 1.55;
  }

  .download-options {
    display: grid;
    gap: 8px;
    margin-block-start: clamp(28px, 4vw, 52px);
  }

  .download-option {
    scroll-margin-block-start: 100px;
  }

  .download-options > a,
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 50px;
    padding: 10px 15px;
    background: var(--surface);
    color: var(--text-primary);
    font-size: 0.96rem;
    font-weight: 650;
    list-style: none;
  }

  summary {
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover,
  .download-options > a:hover {
    background: var(--surface-2);
    color: var(--cyan);
  }

  .is-detected summary,
  .download-options > a.is-detected {
    background: var(--accent);
    color: var(--text-primary);
  }

  .is-detected summary:hover,
  .download-options > a.is-detected:hover {
    background: var(--accent-hover);
    color: #080b1b;
  }

  .package-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border: 1px solid var(--border);
  }

  .package-links a {
    padding: 12px 15px;
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .package-links a:hover {
    background: var(--surface-2);
    color: var(--cyan);
  }

  .hero-meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-block-start: 22px;
    color: var(--text-secondary);
    font-size: 0.82rem;
  }

  @media (max-width: 940px) {
    .hero-stage {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: 20px 40px;
    }

    .download-options {
      margin: 0;
    }

    .hero-meta {
      grid-column: 1 / -1;
      margin: 0;
    }
  }

  @media (max-width: 650px) {
    .hero {
      padding-block: 48px 56px;
    }

    h1 {
      margin-block-end: 38px;
      font-size: clamp(1.75rem, 8.5vw, 4rem);
    }

    .hero-lyric {
      white-space: nowrap;
    }

    .hero-copy {
      display: flex;
      flex-direction: column;
    }

    .download-options {
      order: -1;
      width: 100%;
    }

    .hero-meta {
      width: 100%;
    }
  }
</style>
