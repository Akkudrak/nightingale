---
const flagship = [
  {
    title: "Local multiplayer",
    description:
      "Sing with two to four players, each with their own microphone, profile, color, live score, and place in the final ranking.",
  },
  {
    title: "Your stage, your backdrop",
    description:
      "Turn an image, silent looping video, or Nightingale shader from a local file or HTTPS link into the playback background.",
  },
  {
    title: "Lyrics that follow the song",
    description:
      "Keep word alignment inside line-timed LRC windows and add reading notes for names, dialects, and multilingual lyrics.",
  },
];

const alsoNew = [
  {
    title: "Folder-first browsing",
    description:
      "Browse local music by its folder tree, with albums nested beneath expandable artists.",
  },
  {
    title: "Shared-cache rescans",
    description:
      "Pick up completed analyses from another machine without running the same work again.",
  },
  {
    title: "Settings that stick",
    description:
      "Remember window size, player assignments, microphone channels, and master volume between sessions.",
  },
];
---

<section id="highlights">
  <div class="container highlights-layout">
    <div class="highlights-lead">
      <h2 class="section-title">What’s new in v1.3.0</h2>
      <a href="/docs/" class="docs-link">See full docs <span aria-hidden="true">↗</span></a>
    </div>
    <div class="highlight-list">
      {flagship.map((item) => (
        <article class="highlight">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
      <div class="also-new">
        {alsoNew.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  #highlights {
    border-top: 1px solid var(--border);
  }

  .highlights-layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(40px, 8vw, 120px);
  }

  .highlights-lead .docs-link {
    display: inline-block;
    margin-block-start: 28px;
  }

  .highlight {
    display: grid;
    grid-template-columns: minmax(150px, 0.7fr) 1fr;
    gap: 24px;
    padding-block: 26px;
    border-top: 1px solid var(--border);
  }

  .highlight h3 {
    font-size: 1.3rem;
  }

  .highlight p,
  .also-new p {
    color: var(--text-secondary);
    font-size: 0.94rem;
  }

  .also-new {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
    margin-block-start: 25px;
    padding-block-start: 26px;
    border-top: 1px solid var(--border);
  }

  .also-new h3 {
    margin-block-end: 10px;
    font-size: 1rem;
  }

  @media (max-width: 850px) {
    .highlights-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .highlight,
    .also-new {
      grid-template-columns: 1fr;
    }

    .highlight {
      gap: 12px;
    }

    .also-new {
      gap: 24px;
    }
  }
</style>
