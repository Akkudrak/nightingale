---
const flagship = [
  {
    title: "Playback queue",
    description:
      "Build the set list as people choose songs, see what’s next, remove requests, or clear the queue when plans change.",
  },
  {
    title: "Session mode",
    description:
      "Keep karaoke playing in a dedicated window or browser tab while the main menu stays free for live queue management.",
  },
  {
    title: "Your playback layout",
    description:
      "Place lyrics where they work best and scale lyrics and the pitch graph independently with a live preview.",
  },
];

const alsoNew = [
  {
    title: "Faster library management",
    description:
      "Run analysis, metadata refreshes, realignment, and cache actions across the current filtered song list.",
  },
  {
    title: "Multi-level song sorting",
    description:
      "Sort the compact table by multiple columns with clear priorities that stay saved between sessions.",
  },
  {
    title: "Better microphone setup",
    description:
      "Test microphone recording and playback in Settings, with ASIO support available on Windows.",
  },
];
---

<section id="highlights">
  <div class="container highlights-layout">
    <div class="highlights-lead">
      <h2 class="section-title">What’s new in v1.2.0</h2>
      <a href="/docs/" class="docs-link">See full docs <span aria-hidden="true">↗</span></a>
    </div>
    <div class="highlight-list">
      {flagship.map((item) => (
        <article class="highlight">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
      <div class="also-new">
        {alsoNew.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  #highlights {
    border-top: 1px solid var(--border);
  }

  .highlights-layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(40px, 8vw, 120px);
  }

  .highlights-lead .docs-link {
    display: inline-block;
    margin-block-start: 28px;
  }

  .highlight {
    display: grid;
    grid-template-columns: minmax(150px, 0.7fr) 1fr;
    gap: 24px;
    padding-block: 26px;
    border-top: 1px solid var(--border);
  }

  .highlight h3 {
    font-size: 1.3rem;
  }

  .highlight p,
  .also-new p {
    color: var(--text-secondary);
    font-size: 0.94rem;
  }

  .also-new {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
    margin-block-start: 25px;
    padding-block-start: 26px;
    border-top: 1px solid var(--border);
  }

  .also-new h3 {
    margin-block-end: 10px;
    font-size: 1rem;
  }

  @media (max-width: 850px) {
    .highlights-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .highlight,
    .also-new {
      grid-template-columns: 1fr;
    }

    .highlight {
      gap: 12px;
    }

    .also-new {
      gap: 24px;
    }
  }
</style>
