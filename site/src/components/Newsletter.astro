---
---

<section class="newsletter" id="newsletter">
  <div class="container newsletter-layout">
    <div>
      <h2 class="section-title">Stay in the loop.</h2>
      <p class="section-sub">Get notified about new releases and updates. No spam, unsubscribe anytime.</p>
    </div>
    <div>
      <form id="newsletter-form" class="newsletter-form">
        <label for="newsletter-email">Your email address</label>
        <div class="newsletter-controls">
          <input id="newsletter-email" type="email" name="email" placeholder="your@email.com" required autocomplete="email" />
          <button type="submit">Subscribe <span aria-hidden="true">↗</span></button>
        </div>
      </form>
      <p id="newsletter-msg" class="newsletter-msg" role="status" aria-live="polite"></p>
    </div>
  </div>
</section>

<script>
  const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxFzlGg_WUgvm8OcFAZQZtHQ6CXokE3vqBQwlboT2Rt1QftuF5_NryI_Jk-JSY3HIFjEw/exec";

  const form = document.getElementById("newsletter-form");
  const msg = document.getElementById("newsletter-msg");
  const btn = form?.querySelector("button");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !msg || !btn) return;
    const email = new FormData(form).get("email");
    if (typeof email !== "string" || !email) return;

    btn.disabled = true;
    btn.textContent = "Sending…";
    msg.textContent = "";
    msg.className = "newsletter-msg";

    try {
      const response = await fetch(SCRIPT_URL, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `email=${encodeURIComponent(email)}`,
      });
      if (!response.ok) throw new Error("request failed");
      msg.textContent = "You're in! We'll keep you posted.";
      msg.classList.add("success");
      form.reset();
    } catch {
      msg.textContent = "Something went wrong. Please try again.";
      msg.classList.add("error");
    } finally {
      btn.disabled = false;
      btn.textContent = "Subscribe ↗";
    }
  });
</script>

<style>
  .newsletter {
    border-top: 1px solid var(--border);
    background: #111a38;
  }

  .newsletter-layout {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    align-items: end;
    gap: clamp(40px, 8vw, 120px);
  }

  .newsletter-form label {
    display: block;
    margin-block-end: 10px;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .newsletter-controls {
    display: flex;
    gap: 8px;
  }

  input {
    width: 100%;
    min-width: 0;
    min-height: 52px;
    padding: 12px 15px;
    border: 1px solid #777e9e;
    border-radius: 0;
    background: var(--bg);
    color: var(--text-primary);
  }

  input::placeholder {
    color: var(--text-dim);
  }

  button {
    flex: none;
    padding-inline: 20px;
    border: 0;
    background: var(--accent);
    color: white;
    font-weight: 650;
  }

  button:hover {
    background: var(--accent-hover);
    color: #080b1b;
  }

  button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .newsletter-msg {
    min-height: 1.5em;
    margin-block-start: 10px;
    font-size: 0.9rem;
  }

  .success {
    color: #69eaa2;
  }

  .error {
    color: #ffaaa8;
  }

  @media (max-width: 780px) {
    .newsletter-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 460px) {
    .newsletter-controls {
      flex-direction: column;
    }

    button {
      min-height: 52px;
    }
  }
</style>
