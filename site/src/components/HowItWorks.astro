---
const steps = [
  {
    title: "Choose music",
    description: "Use a folder, Plex, Jellyfin, or Navidrome.",
  },
  {
    title: "Prepare audio",
    description:
      "Make an instrumental, or sing over the original mix with your own lyrics.",
  },
  {
    title: "Get lyrics",
    description:
      "Use a local LRC, paste lyrics, find a match, or transcribe the song.",
  },
  {
    title: "Sing",
    description:
      "Follow synced lyrics, adjust key and tempo, and score your pitch.",
  },
];
---

<section id="how-it-works">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">From track<br />to stage.</h2>
      <a href="/docs/how-it-works.html" class="docs-link">See full process <span aria-hidden="true">↗</span></a>
    </div>
    <ol class="steps">
      {steps.map((step, index) => (
        <li class="step">
          <span class="step-num">{String(index + 1).padStart(2, "0")}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  #how-it-works {
    border-top: 1px solid var(--border);
    background: var(--bg-2);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .step {
    padding: 28px clamp(20px, 2.2vw, 32px) 0 0;
  }

  .step:not(:first-child) {
    padding-inline-start: clamp(20px, 2.2vw, 32px);
    border-inline-start: 1px solid var(--border);
  }

  .step-num {
    display: block;
    margin-block-end: 56px;
    color: var(--cyan);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .step h3 {
    margin-block-end: 16px;
    font-size: 1.5rem;
  }

  .step p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  @media (max-width: 840px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .step {
      padding-block-end: 40px;
    }

    .step:nth-child(3) {
      padding-inline-start: 0;
      border-inline-start: 0;
    }

    .step-num {
      margin-block-end: 24px;
    }
  }

  @media (max-width: 530px) {
    #how-it-works {
      padding-block: 56px;
    }

    .steps {
      grid-template-columns: 1fr;
    }

    .step,
    .step:not(:first-child) {
      padding: 24px 0;
      border-inline-start: 0;
      border-bottom: 1px solid var(--border);
    }

    .step-num {
      margin-block-end: 16px;
    }
  }
</style>
