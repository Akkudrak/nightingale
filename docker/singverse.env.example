# Copy to docker/singverse.env (never commit the real one).

# The domain this VPS answers on, e.g. karaoke.singverse.example. Its DNS must point here.
KARAOKE_DOMAIN=karaoke.example.com

# SingVerse's public URL (no trailing slash).
SINGVERSE_URL=https://singverse.example.com

# Same value as NIGHTINGALE_SECRET in SingVerse's .env. At least 32 random characters:
#   openssl rand -hex 32
SINGVERSE_SECRET=

# Disk for downloaded songs, in MB.
SINGVERSE_CACHE_MB=4096
